{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app8",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ffb9ac92-c852-45e1-be56-81129e3b842c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "57b849c441624993a0066eb64c0eb613" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
